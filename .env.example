# Local PostgreSQL settings used by compose.yaml
POSTGRES_DB=bird_recognition
POSTGRES_USER=bird_recognition
POSTGRES_PASSWORD=bird_recognition
POSTGRES_PORT=5432

# Local Ollama settings for vision-language testing
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b

# Local bird-recognition CLI defaults (explicit CLI options take precedence)
BIRD_RECOGNITION_INTERVAL=1.0
BIRD_RECOGNITION_ANIMAL_THRESHOLD=0.2
BIRD_RECOGNITION_PERSON_THRESHOLD=0.2
BIRD_RECOGNITION_EXTENSIONS=.mp4,.mov,.m4v,.mkv,.avi,.mpeg,.mpg
BIRD_RECOGNITION_MEGADETECTOR_MODEL=
BIRD_RECOGNITION_MEGADETECTOR_CONFIG=

# Optional real-model smoke-test paths; set all three to enable the smoke test
BIRD_RECOGNITION_SMOKE_MODEL=
BIRD_RECOGNITION_SMOKE_CONFIG=
BIRD_RECOGNITION_SMOKE_IMAGE=
