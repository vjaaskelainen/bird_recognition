# Compose-only PostgreSQL settings; the application never derives its database URL
# from these values. Replace the password placeholder in a private local .env.
POSTGRES_DB=bird_recognition
POSTGRES_USER=bird_recognition
POSTGRES_PASSWORD=replace-with-local-compose-password
POSTGRES_PORT=5432

# Local Ollama settings for vision-language testing
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b

# Local bird-recognition CLI defaults (explicit CLI options take precedence)
# Application database credentials must be supplied privately; there is no default.
BIRD_RECOGNITION_DATABASE_URL=
BIRD_RECOGNITION_INTERVAL=1.0
BIRD_RECOGNITION_ANIMAL_THRESHOLD=0.2
BIRD_RECOGNITION_PERSON_THRESHOLD=0.2
BIRD_RECOGNITION_EXTENSIONS=.mp4,.mov,.m4v,.mkv,.avi,.mpeg,.mpg
BIRD_RECOGNITION_MEGADETECTOR_MODEL=
BIRD_RECOGNITION_MEGADETECTOR_CONFIG=

# Optional embedding-index defaults; leave asset/species paths empty unless configured.
BIRD_RECOGNITION_BIOCLIP_MODEL_DIR=
BIRD_RECOGNITION_SPECIES_LIST=
BIRD_RECOGNITION_SPECIES_THRESHOLD=0.5

# Opt-in tests use only a disposable local database and external privacy-reviewed assets.
BIRD_RECOGNITION_TEST_DATABASE_URL=
BIRD_RECOGNITION_BIOCLIP_SMOKE_MODEL_DIR=
BIRD_RECOGNITION_BIOCLIP_SMOKE_IMAGE=

# Existing ingestion model smoke-test paths; set all three only for that smoke test.
BIRD_RECOGNITION_SMOKE_MODEL=
BIRD_RECOGNITION_SMOKE_CONFIG=
BIRD_RECOGNITION_SMOKE_IMAGE=
